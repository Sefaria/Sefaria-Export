{
    "text": {
        "0": {
            "0": "Lechah Dodi Likrat Kallah  ",
            "1": "Pnei Shabbat NeKabelah"
        },
        "1": {
            "0": "Shamor Vezachor Bedibur Echad  ",
            "1": "Hishmi'anu El HaMeyuchad  ",
            "2": "Adonai Echad Ushemo Echad  ",
            "3": "Leshem UlTiferet ULTehillah"
        },
        "3": {
            "0": "Mikdash Melech Ir Meluchah  ",
            "1": "Kumi Tzei Mitoch Hahafêchah  ",
            "2": "Rav Lach Shevet Beêmek Habakha  ",
            "3": "Vehu Yachamol Alayich Chemlah"
        },
        "4": {
            "0": "Hitnaari meafar kumi  ",
            "1": "Livshi bigdei tifarteich ami  ",
            "2": "Al yad ben Yishai beit halachmi  ",
            "3": "K'rava el nafshi gealah"
        },
        "5": {
            "0": "Hit'orêri hit'orêri  ",
            "1": "Ki va orech, kumi ori  ",
            "2": "Uri uri, shir dabêri  ",
            "3": "Khevôd Adonai alayich nigláh"
        },
        "6": {
            "0": "Lo tevoshi velo ticcami",
            "1": "Mah tistochchi umah tehemmi",
            "2": "Bach yechesu aniyei ammi",
            "3": "Venivneita ir al tillah"
        },
        "7": {
            "0": "Vehayu limshisah shosayich  ",
            "1": "Verachaku chol mevaleyayich  ",
            "2": "Yasis alayich Elohayich  ",
            "3": "Kimsose chatan al kallah"
        },
        "8": {
            "0": "Yamim Usmol Tifrotsi  ",
            "1": "Ve'et Adonai Ta'aritsi  ",
            "2": "Al Yad Ish Ben Partsi  ",
            "3": "Venismecha Venagilah"
        },
        "9": {
            "0": "Boí veshalóm atérét baaláh  ",
            "1": "Gam besimcháh uvetzaholah  ",
            "2": "Tóch emunéi am seguláh  ",
            "3": "Boí kalláh boí kalláh"
        }
    },
    "meta": "Verse-Verset",
    "work": "Lekha Dodi"
