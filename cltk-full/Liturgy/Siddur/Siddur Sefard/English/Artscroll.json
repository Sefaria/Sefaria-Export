        "7_Lag BaOmer Songs": {
            "0_Amar Rabbi Akiva": {},
            "1_Ashreinu Ma Tov": {},
            "2_Ashreinu Uma Naim": {},
            "3_Bar Yochai": {
                "2": "Bar Yochai! You were anointed",
                "3": "– you are fortunate –",
                "4": "With oil of joy from your fellows.",
                "5": "Bar Yochai! With oil of sacred anointment",
                "6": "were you anointed from the holy measure",
                "7": "You bore the headplate, a crown of holiness,",
                "8": "bound upon your head is your glory.",
                "9": "Bar Yochai! You were anointed – you are fortunate –",
                "10": "With oil of joy from your fellows.",
                "11": "Bar Yochai! In a goodly dwelling did you settle",
                "12": "on the day you ran, the day you fled,",
                "13": "In rocky caves where you stopped –",
                "14": "there you acquired your glory and your strength.",
                "15": "Bar Yochai! You were anointed – you are fortunate –",
                "16": "With oil of joy from your fellows.",
                "17": "Bar Yochai! Like standing shittim beams,",
                "18": "the teachings of God they study",
                "19": "An extraordinary light is the light of the fire",
                "20": "that they kindle – they, your teachers, will teach you.",
                "21": "Bar Yochai! You were anointed – you are fortunate –",
                "22": "With oil of joy from your fellows.",
                "23": "Bar Yochai! You came to a Field of Apples",
                "24": "and entered it to pick confections:",
                "25": "The mystery of Torah with blossoms and flowers –",
                "26": "‘Let us create man’ was said because of You.",
                "27": "Bar Yochai! You were anointed – you are fortunate –",
                "28": "With oil of joy from Your fellows.",
                "29": "Bar Yochai! You were girded with strength,",
                "30": "and in the war of the fiery Torah up to the gate",
                "31": "You pulled a sword from its scabbard,",
                "32": "you drew it against your enemies.",
                "33": "Bar Yochai! You were anointed – you are fortunate –",
                "34": "With oil of joy from your fellows.",
                "35": "Bar Yochai! To a place of marble stones,",
                "36": "you arrived, and before a huge lion.",
                "37": "Even a rounded crown upon a constellation’s star",
                "38": "you perceived – but none can perceive you.",
                "39": "Bar Yochai! You were anointed – you are fortunate –",
                "40": "With oil of joy from your fellows.",
                "41": "Bar Yochai! In the Holy of Holies,",
                "42": "a green line creates new manifestations",
                "43": "Seven weeks are the secret of the fifty,",
                "44": "you bound the bonds of Shin as your bonds.",
                "45": "Bar Yochai! You were anointed – you are fortunate –",
                "46": "With oil of joy from your fellows.",
                "47": "Bar Yochai! The Yud of earliest wisdom,",
                "48": "you gazed into its innermost honor,",
                "49": "The thirty-two paths of the very first tithe,",
                "50": "you are like a cherub anointed with the glow",
                "51": "of your illumination.",
                "52": "Bar Yochai! You were anointed – you are fortunate –",
                "53": "With oil of joy from your fellows.",
                "54": "Bar Yochai! At a wondrous light in lofty heights",
                "55": "you feared to stare for it is great.",
                "56": "Such hiddenness that one calls her, ‘Naught’.",
                "57": "You declared that no eye could glimpse You.",
                "58": "Bar Yochai! You were anointed – you are fortunate –",
                "59": "With oil of joy from your fellows.",
                "60": "Bar Yochai! Fortunate is she who bore you,",
                "61": "fortunate is the people that learns from you,",
                "62": "And fortunate are those who can plumb your mystery,",
                "63": "garbed in the priestly breastplate",
                "64": "and Your Ineffable Name,",
                "65": "Bar Yochai! You were anointed – you are fortunate –",
                "66": "With oil of joy from your fellows.\n"
            },
