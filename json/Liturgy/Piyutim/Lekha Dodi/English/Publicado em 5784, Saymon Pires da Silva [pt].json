    "text": [
        [
            "Lechah Dodi Likrat Kallah  ",
            "Pnei Shabbat NeKabelah"
        ],
        [
            "Shamor Vezachor Bedibur Echad  ",
            "Hishmi'anu El HaMeyuchad  ",
            "Adonai Echad Ushemo Echad  ",
            "Leshem UlTiferet ULTehillah"
        ],
        [],
        [
            "Mikdash Melech Ir Meluchah  ",
            "Kumi Tzei Mitoch Hahafêchah  ",
            "Rav Lach Shevet Beêmek Habakha  ",
            "Vehu Yachamol Alayich Chemlah"
        ],
        [
            "Hitnaari meafar kumi  ",
            "Livshi bigdei tifarteich ami  ",
            "Al yad ben Yishai beit halachmi  ",
            "K'rava el nafshi gealah"
        ],
        [
            "Hit'orêri hit'orêri  ",
            "Ki va orech, kumi ori  ",
            "Uri uri, shir dabêri  ",
            "Khevôd Adonai alayich nigláh"
        ],
        [
            "Lo tevoshi velo ticcami",
            "Mah tistochchi umah tehemmi",
            "Bach yechesu aniyei ammi",
            "Venivneita ir al tillah"
        ],
        [
            "Vehayu limshisah shosayich  ",
            "Verachaku chol mevaleyayich  ",
            "Yasis alayich Elohayich  ",
            "Kimsose chatan al kallah"
        ],
        [
            "Yamim Usmol Tifrotsi  ",
            "Ve'et Adonai Ta'aritsi  ",
            "Al Yad Ish Ben Partsi  ",
            "Venismecha Venagilah"
        ],
        [
            "Boí veshalóm atérét baaláh  ",
            "Gam besimcháh uvetzaholah  ",
            "Tóch emunéi am seguláh  ",
            "Boí kalláh boí kalláh"
        ]
    ],
