{
    "text": {
        "0_Verse, 0_Verset": "Lechah Dodi Likrat Kallah  ",
        "0_Verse, 1_Verset": "Pnei Shabbat NeKabelah",
        "1_Verse, 0_Verset": "Shamor Vezachor Bedibur Echad  ",
        "1_Verse, 1_Verset": "Hishmi'anu El HaMeyuchad  ",
        "1_Verse, 2_Verset": "Adonai Echad Ushemo Echad  ",
        "1_Verse, 3_Verset": "Leshem UlTiferet ULTehillah",
        "3_Verse, 0_Verset": "Mikdash Melech Ir Meluchah  ",
        "3_Verse, 1_Verset": "Kumi Tzei Mitoch Hahafêchah  ",
        "3_Verse, 2_Verset": "Rav Lach Shevet Beêmek Habakha  ",
        "3_Verse, 3_Verset": "Vehu Yachamol Alayich Chemlah",
        "4_Verse, 0_Verset": "Hitnaari meafar kumi  ",
        "4_Verse, 1_Verset": "Livshi bigdei tifarteich ami  ",
        "4_Verse, 2_Verset": "Al yad ben Yishai beit halachmi  ",
        "4_Verse, 3_Verset": "K'rava el nafshi gealah",
        "5_Verse, 0_Verset": "Hit'orêri hit'orêri  ",
        "5_Verse, 1_Verset": "Ki va orech, kumi ori  ",
        "5_Verse, 2_Verset": "Uri uri, shir dabêri  ",
        "5_Verse, 3_Verset": "Khevôd Adonai alayich nigláh",
        "6_Verse, 0_Verset": "Lo tevoshi velo ticcami",
        "6_Verse, 1_Verset": "Mah tistochchi umah tehemmi",
        "6_Verse, 2_Verset": "Bach yechesu aniyei ammi",
        "6_Verse, 3_Verset": "Venivneita ir al tillah",
        "7_Verse, 0_Verset": "Vehayu limshisah shosayich  ",
        "7_Verse, 1_Verset": "Verachaku chol mevaleyayich  ",
        "7_Verse, 2_Verset": "Yasis alayich Elohayich  ",
        "7_Verse, 3_Verset": "Kimsose chatan al kallah",
        "8_Verse, 0_Verset": "Yamim Usmol Tifrotsi  ",
        "8_Verse, 1_Verset": "Ve'et Adonai Ta'aritsi  ",
        "8_Verse, 2_Verset": "Al Yad Ish Ben Partsi  ",
        "8_Verse, 3_Verset": "Venismecha Venagilah",
        "9_Verse, 0_Verset": "Boí veshalóm atérét baaláh  ",
        "9_Verse, 1_Verset": "Gam besimcháh uvetzaholah  ",
        "9_Verse, 2_Verset": "Tóch emunéi am seguláh  ",
        "9_Verse, 3_Verset": "Boí kalláh boí kalláh"
    },
    "meta": "Verse-Verset",
    "work": "Lekha Dodi"
